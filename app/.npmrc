# Endurecimiento de npm (supply chain):
# - ignore-scripts: ningún paquete ejecuta scripts install/postinstall (vector clásico de malware en npm).
# - save-exact: versiones exactas, sin rangos ^ ~ que traigan versiones no revisadas.
# - audit-level: npm audit falla desde severidad "high".
# - min-release-age: no resuelve versiones publicadas hace menos de 7 días (npm >= 11.10).
#   Los paquetes maliciosos de ataques de supply chain suelen detectarse y retirarse antes.
ignore-scripts=true
min-release-age=7
save-exact=true
audit-level=high
fund=false
engine-strict=true
